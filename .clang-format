# 设为 false 时，clangd 不进行格式化（可避免保存时�??�?动格式化�?
DisableFormat: false
BasedOnStyle: LLVM

IndentWidth: 4
TabWidth: 4
UseTab: Never

# Allman 风格：{ �? } 单独一�?
BreakBeforeBraces: Allman
# 不允许将�?块放在一�?
AllowShortBlocksOnASingleLine: false
# 不允许将�? if �?句放在一�?
AllowShortIfStatementsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None

SortIncludes: false

# 行长度限制，0表示不限制（允�?�参数和赋值在一行）
ColumnLimit: 0

# 允�?�参数打包在一�?
BinPackArguments: true
BinPackParameters: true

# 不允许所有参数都换到下一�?
AllowAllParametersOfDeclarationOnNextLine: false

# 对齐连续的宏定义，保�? #define 的值垂直�?�齐
AlignConsecutiveMacros: Consecutive

# 不全局对齐 = （AlignConsecutiveAssignments 会同时影�? .c �? enum，无法只针�?? enum�?
# enum �?�? = 请用 // clang-format off/on 包裹后手动�?�齐

# SpacesInLineComment 仅在 ReflowComments �? Never 时生�?
ReflowComments: Always
# 注释�? // 后面不添加空格，文字紧接 //
SpacesInLineCommentPrefix:
  Minimum: 0
  Maximum: 0