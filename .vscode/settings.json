{
    // 配置 MSYS2 为 Cursor 的默认终端
    "terminal.integrated.defaultProfile.windows": "MSYS2",
    // MSYS2 终端配置
    "terminal.integrated.profiles.windows": {
        "MSYS2": {
            "path": "C:\\msys64\\msys2_shell.cmd",
            "args": [
                "-defterm",
                "-here",
                "-no-start",
                "-mingw64",
                "-shell",
                "zsh"
            ],
            "env": {
                "CHERE_INVOKING": "1",
                "MSYSTEM": "MINGW64"
            },
            "icon": "terminal"
        },
        "MSYS2 UCRT64": {
            "path": "C:\\msys64\\ucrt64.exe",
            "args": [],
            "icon": "terminal"
        },
        "MSYS2 MSYS": {
            "path": "C:\\msys64\\msys2_shell.cmd",
            "args": [
                "-defterm",
                "-here",
                "-no-start",
                "-msys",
                "-shell",
                "zsh"
            ],
            "env": {
                "CHERE_INVOKING": "1",
                "MSYSTEM": "MSYS"
            },
            "icon": "terminal"
        }
    },
    // 编辑器字体设置
    "editor.fontSize": 18,
    "editor.fontFamily": "Consolas, 'Microsoft YaHei Mono', 'Courier New', monospace",
    "editor.lineHeight": 1.6,
    // 终端设置
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.fontFamily": "Consolas, 'Microsoft YaHei Mono', 'Courier New', monospace",
    "terminal.integrated.fontSize": 18,
    "terminal.integrated.encoding": "utf8",
    // Git 配置 - 确保使用 Windows Git（不会影响仓库）
    "git.path": "C:\\Program Files\\Git\\cmd\\git.exe",
    // 文件编码设置（默认用 GB2312 打开/保存，便于 .c 等源文件中文显示）
   // "files.encoding": "gb2312",
      "files.encoding": "utf8",// 如果原工程是UTF-8 那么启用此行
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    // 禁用Insert键切换覆盖模式（解决替换模式问题）
    "editor.overtypeMode": false,
