    // 编辑器语法高亮颜色（适配护眼色背景）
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": ["comment", "punctuation.definition.comment"],
                "settings": { "foreground": "#6F625C", "fontStyle": "italic" }
            },
            {
                "scope": ["keyword", "storage.type", "storage.modifier"],
                "settings": { "foreground": "#2F6FDB", "fontStyle": "bold" }
            },
            {
                "scope": ["string", "string.quoted", "string.template"],
                "settings": { "foreground": "#8A3D1A" }
            },
            {
                "scope": ["constant.numeric", "constant.language", "constant.character"],
                "settings": { "foreground": "#8A5A00" }
            },
            {
                "scope": ["entity.name.function", "support.function"],
                "settings": { "foreground": "#1E5BB8", "fontStyle": "bold" }
            },
            {
                "scope": ["entity.name.type", "support.type", "storage.type.class", "storage.type.struct", "storage.type.enum"],
                "settings": { "foreground": "#7B2CBF", "fontStyle": "bold" }
            },
            {
                "scope": ["variable.parameter"],
                "settings": { "foreground": "#3B2C26" }
            },
            {
                "scope": ["variable.other.member", "support.variable", "property"],
                "settings": { "foreground": "#6B5A52" }
            },
            {
                "scope": ["entity.name.constant", "constant.other", "variable.other.constant"],
                "settings": { "foreground": "#1F7A4D", "fontStyle": "bold" }
            },
            {
                "scope": ["entity.name.macro", "meta.preprocessor", "keyword.control.import"],
                "settings": { "foreground": "#0B6B6B", "fontStyle": "bold" }
            }
        ]
    },
    "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
            "variable": "#3B2C26",
            "parameter": "#2F241F",
            "property": "#6B5A52",
            "variable:member": "#6B5A52",
            "enumMember": "#1F7A4D",
            "variable:readonly": "#1F7A4D",
            "function": "#1A5C8C",
            "method": "#1A5C8C",
            "type": "#7B2CBF",
            "class": "#7B2CBF",
            "struct": "#7B2CBF",
            "enum": "#7B2CBF",
            "typeParameter": "#7B2CBF",
            "macro": "#006D6F",
            "number": "#8A5A00",
            "keyword": "#2F6FDB"
        }
    },
    // C/C++ IntelliSense 配置
    // 让 cpptools 不抢语义/跳转，全部交给 clangd
    "C_Cpp.intelliSenseEngine": "Disabled",
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.errorSquiggles": "disabled",
    "C_Cpp.suggestSnippets": false,
    "C_Cpp.enhancedColorization": "enabled",
    // C/C++ 代码格式化配置
    "C_Cpp.clang_format_path": "C:\\Program Files\\LLVM\\bin\\clang-format.exe",
    "C_Cpp.clang_format_style": "file",
    "C_Cpp.formatting": "clangFormat",
    "editor.formatOnSave": true,
    // 默认格式化程序设置（使用 clangd 扩展）
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true
    },
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true
    },
    "[h]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true
    },
    "[hpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true
    },
    "C_Cpp.default.browse.limitSymbolsToIncludedHeaders": false,
    "C_Cpp.default.systemIncludePath": [],
    "C_Cpp.default.defines": [
        "USE_HAL_DRIVER",
        "STM32L431xx"
    ],
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/Core/Inc",
        "${workspaceFolder}/HardwareDriver",
        "${workspaceFolder}/Drivers/STM32L4xx_HAL_Driver/Inc",
        "${workspaceFolder}/Drivers/STM32L4xx_HAL_Driver/Inc/Legacy",
        "${workspaceFolder}/Drivers/CMSIS/Device/ST/STM32L4xx/Include",
        "${workspaceFolder}/Drivers/CMSIS/Include"
    ],
    // 确保符号数据库正常工作
    "C_Cpp.default.browse.databaseFilename": "${workspaceFolder}/.vscode/browse.vc.db",
    "C_Cpp.default.browse.path": [
        "${workspaceFolder}"
    ],
    // 启用所有语言功能
    "C_Cpp.intelliSenseUpdateDelay": 2000,
    "C_Cpp.workspaceParsingPriority": "highest",
    // 禁用平台包下载提示和自动下载
    "C_Cpp.updateChannel": "Default",
    "C_Cpp.intelliSenseEngineFallback": "Disabled",
    "C_Cpp.disableAutomaticInstallation": true,
    // clangd 配置
    // clangd 已通过 MSYS2 安装
    "clangd.path": "C:\\msys64\\mingw64\\bin\\clangd.exe",
    "clangd.arguments": [
        "--background-index",
        "--clang-tidy",
        "--completion-style=detailed",
        "--header-insertion=iwyu",
        "--header-insertion-decorators"
    ],
    "clangd.fallbackFlags": [
        "-std=c11"
    ],
    "clangd.onConfigChanged": "restart",
    // 禁用 clangd 的格式化，使用 C/C++ 扩展的 clang-format
    // 允许 clangd 负责格式化
    "clangd.formatting": "enabled",
    // Vim 插件设置（如果安装了Vim插件，禁用替换模式快捷键）
    "vim.overrideCopy": false,
    "vim.handleKeys": {
        "<Insert>": false
    },
    // 编辑器行为设置 - 确保始终使用插入模式
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.tabSize": 4
}